# Copy to .env and replace every placeholder. Never commit .env or real credentials.
# Generate random secrets with:  npm run secret
# Full guide: docs/setup.md

# ---------------------------------------------------------------------------
# Local PostgreSQL (read by docker-compose.yml when you run `npm run db:up`)
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=replace-with-npm-run-secret
NEXORA_APP_PASSWORD=replace-with-npm-run-secret

# ---------------------------------------------------------------------------
# Database (src/server/env.ts)
# ---------------------------------------------------------------------------
# Required. The app connects as nexora_app (data only: no DDL, cannot edit journals).
# Must start with postgres:// or postgresql://. Use the NEXORA_APP_PASSWORD value above.
DATABASE_URL=postgres://nexora_app:replace-with-app-password@localhost:5432/nexora
# Used by `npm run db:migrate` and `npm run db:seed` (schema owner). Falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=postgres://nexora_owner:replace-with-owner-password@localhost:5432/nexora
# Optional. Connections per server process, 1–50. Default 10.
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Authentication (src/server/env.ts)
# ---------------------------------------------------------------------------
# Required. Secret key for hashing sign-in codes. At least 32 characters.
# Changing it invalidates codes that are currently waiting to be used.
OTP_PEPPER=replace-with-npm-run-secret
# Optional. One-time token for first-run shop setup at /setup. At least 32 characters.
# Leave empty to disable /setup. Remove it again after your shop is created.
SETUP_TOKEN=
# Where sign-in codes go: "console" (development only — prints to the server terminal)
# or "msg91" (placeholder, not implemented yet). "console" is refused in production.
SMS_PROVIDER=console
# Optional. Session cookie name: lowercase letters and _ only. Default nx_session.
# In production the cookie is automatically named __Host-<name>.
SESSION_COOKIE_NAME=nx_session

# ---------------------------------------------------------------------------
# Development seed (db/seed/sample-shop.ts)
# ---------------------------------------------------------------------------
# The sample shop loads only when this is "true", NODE_ENV is not production,
# and the database host is localhost.
SEED_ALLOW=false

# WhatsApp (optional). Empty = manual Copy / Open WhatsApp only. "meta" = WhatsApp Business Cloud API.
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with one body variable (needed outside the 24-hour chat window).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
# Webhook: signature secret and subscription verify token.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Scheduler calling POST /api/jobs/whatsapp with "Authorization: Bearer ..." (32+ characters).
CRON_SECRET=
