# Copy to .env and fill in local values. Never commit .env or real credentials.

# App
NODE_ENV=development
APP_URL=http://localhost:3000
TZ=Asia/Kolkata

# Local PostgreSQL (docker compose). Choose your own passwords.
POSTGRES_PASSWORD=change-me-owner-password
NEXORA_APP_PASSWORD=change-me-app-password

# The app connects as nexora_app (no DDL, cannot edit journals).
DATABASE_URL=postgres://nexora_app:change-me-app-password@localhost:5432/nexora
# Migrations and seed run as the schema owner.
DATABASE_MIGRATION_URL=postgres://nexora_owner:change-me-owner-password@localhost:5432/nexora
DATABASE_POOL_MAX=10

# Development seed guard: the sample shop is only loaded when this is "true",
# NODE_ENV is not production, and the database host is localhost.
SEED_ALLOW=true

# Later phases (not used yet)
SETUP_TOKEN=
OTP_PEPPER=
SESSION_COOKIE_NAME=nx_session
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_TEMPLATE_ID=
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=nexora-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
JOBS_ENABLED=false
ERROR_TRACKING_DSN=
